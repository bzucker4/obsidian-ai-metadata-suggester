{
  "name": "obsidian-ai-metadata-suggester",
  "version": "1.1.0",
  "description": "Obsidian plugin that suggests tags, aliases, and summary metadata for notes using AI, with review before applying.",
  "main": "main.js",
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint main.ts --ext .ts",
    "test": "node --test tests/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "metadata",
    "tags"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzucker4/obsidian-ai-metadata-suggester.git"
  },
  "bugs": {
    "url": "https://github.com/bzucker4/obsidian-ai-metadata-suggester/issues"
  },
  "homepage": "https://github.com/bzucker4/obsidian-ai-metadata-suggester#readme",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "builtin-modules": "^5.5.0",
    "esbuild": "0.17.3",
    "eslint": "^8.57.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
